# Read by gateway/server.py when started with `python -m gateway.server`.
# The app does not load this file itself: export the variables in your shell.
# Both are optional.

# Interface to bind. Keep 127.0.0.1 unless you understand the exposure: there is no authentication.
PA_GATEWAY_HOST=127.0.0.1
# Fixed port. If unset, the first free port from 8080 is used.
PA_GATEWAY_PORT=8080
